{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Private authenticated user profile and workspace preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "preferredLocale": {
          "type": "string",
          "enum": ["en", "ar"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "preferredLocale", "createdAt", "updatedAt"]
    },
    "WorkspacePin": {
      "title": "WorkspacePin",
      "description": "A user-pinned Google Workspace resource (Drive file, Sheet, Form, Classroom course, or Meet space).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serviceKey": {
          "type": "string",
          "enum": ["drive", "sheets", "gmail", "tasks", "chat", "forms", "meet", "classroom"]
        },
        "resourceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "maxLength": 1024
        },
        "notes": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "serviceKey", "resourceId", "title", "createdAt", "updatedAt"]
    },
    "StudyNote": {
      "title": "StudyNote",
      "description": "Operational or lesson preparation note persisted for the authenticated educator or user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "serviceKey": {
          "type": "string",
          "enum": ["general", "drive", "sheets", "gmail", "tasks", "chat", "forms", "meet", "classroom"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["ownerId", "title", "content", "serviceKey", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile isolated to the authenticated owner."
    },
    "/workspacePins/{pinId}": {
      "schema": { "$ref": "#/entities/WorkspacePin" },
      "description": "Pinned Google Workspace items belonging to the authenticated owner."
    },
    "/studyNotes/{noteId}": {
      "schema": { "$ref": "#/entities/StudyNote" },
      "description": "Operational and academic notes belonging to the authenticated owner."
    }
  }
}
